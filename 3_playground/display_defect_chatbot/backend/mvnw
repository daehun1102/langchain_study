# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.4
# ----------------------------------------------------------------------------

set -e

# OS specific support.
cygwin=false
darwin=false
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  DARWIN*) darwin=true ;;
  MINGW*) mingw=true ;;
esac

## -z is an empty variable check, -n is a non-empty variable check
if [ -z "$JAVA_HOME" ] ; then
  if [ -r /etc/gentoo-release ] ; then
    JAVA_HOME=$(java-config --jre-home)
  fi
fi

# For Cygwin, ensure paths are in UNIX format before anything is touched
if $cygwin ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME=$(cygpath --unix "$JAVA_HOME")
  [ -n "$CLASSPATH" ] && CLASSPATH=$(cygpath --path --unix "$CLASSPATH")
fi

# For Mingw, ensure paths are in UNIX format before anything is touched
if $mingw ; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME="$(cd "$JAVA_HOME" && pwd)"
fi

if [ -z "$JAVA_HOME" ]; then
  javaExecutable="$(which javac)"
  if [ -n "$javaExecutable" ] && ! [ "$(expr "$javaExecutable" : '\([^ ]*\)')" = "no" ]; then
    # readlink(1) is not available as standard on Solaris 10.
    readLink=$(which readlink)
    if [ ! "$(expr "$readLink" : '\([^ ]*\)')" = "no" ]; then
      if $darwin ; then
        javaHome="$(dirname "$javaExecutable")"
        javaExecutable="$(readlink "$javaHome/../javac")"
        javaHome="$(dirname "$javaExecutable")"
        javaHome="$(cd "$javaHome/.." && pwd)"
      else
        javaHome="$(dirname "$(readlink -f "$javaExecutable")")"
        javaHome="$(cd "$javaHome/.." && pwd)"
      fi
      if [ -z "$JAVA_HOME" ]; then
        JAVA_HOME="$javaHome"
      fi
    fi
  fi
fi

PROPERTIES_FILE="$(cd "$(dirname "$0")" && pwd)/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$PROPERTIES_FILE" ]; then
  DISTRIBUTION_URL=$(grep '^distributionUrl=' "$PROPERTIES_FILE" | sed 's/distributionUrl=//')
fi

if [ -z "$DISTRIBUTION_URL" ]; then
  echo "Error: distributionUrl not found in $PROPERTIES_FILE"
  exit 1
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_DIST_DIR="$MAVEN_USER_HOME/wrapper/dists"

# Extract archive name: apache-maven-3.9.12-bin.zip -> apache-maven-3.9.12
DIST_FILENAME=$(basename "$DISTRIBUTION_URL")
DIST_NAME="${DIST_FILENAME%-bin.zip}"
MAVEN_HOME_LOCAL="$MAVEN_DIST_DIR/$DIST_NAME"

if [ ! -d "$MAVEN_HOME_LOCAL" ]; then
  echo "Downloading Maven from: $DISTRIBUTION_URL"
  mkdir -p "$MAVEN_DIST_DIR"
  DIST_ZIP="$MAVEN_DIST_DIR/$DIST_FILENAME"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL -o "$DIST_ZIP" "$DISTRIBUTION_URL"
  elif command -v wget > /dev/null 2>&1; then
    wget -q -O "$DIST_ZIP" "$DISTRIBUTION_URL"
  else
    echo "Error: Neither curl nor wget is available."
    exit 1
  fi
  unzip -q "$DIST_ZIP" -d "$MAVEN_DIST_DIR"
  rm -f "$DIST_ZIP"
fi

MVN_CMD="$MAVEN_HOME_LOCAL/bin/mvn"

if [ ! -f "$MVN_CMD" ]; then
  echo "Error: mvn not found at $MVN_CMD"
  exit 1
fi

exec "$MVN_CMD" "$@"
