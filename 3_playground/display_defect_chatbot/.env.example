# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=defect_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── 모델 ─────────────────────────────────────────────────────────────────────
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── 그래프 상태 로깅 ──────────────────────────────────────────────────────────
# 노드 진입/종료 시 입력·출력 상태값을 로깅합니다.
#
# LOG_GRAPH_ENABLED  : true | false       (기본: false)
# LOG_GRAPH_TARGET   : console | file | both  (기본: console)
# LOG_GRAPH_FILE     : 로그 파일 경로 — target이 file/both일 때만 사용 (기본: logs/graph.log)
# LOG_GRAPH_LEVEL    : DEBUG | INFO | WARNING | ERROR  (기본: INFO)
LOG_GRAPH_ENABLED=false
LOG_GRAPH_TARGET=console
LOG_GRAPH_FILE=logs/graph.log
LOG_GRAPH_LEVEL=INFO

# ── 이메일 알림 (장기 이력 완료 알림) ─────────────────────────────────────────
# Gmail 사용 시: 앱 비밀번호(App Password) 사용 필요
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
